{
  "version": "2.0.0",
  "tasks": [

    // ── Python Services (native Windows) ──────────────────────────────────
    {
      "label": "Worker: Start (native)",
      "type": "shell",
      "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
      "args": ["-m", "uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8002", "--reload"],
      "options": {
        "cwd": "${workspaceFolder}/worker-service",
        "env": { "PYTHONPATH": "${workspaceFolder}/worker-service;${workspaceFolder}/database-service;${workspaceFolder}" }
      },
      "isBackground": true,
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true },
      "problemMatcher": {
        "owner": "worker",
        "pattern": { "regexp": "^ERROR" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Started server process",
          "endsPattern": "Application startup complete"
        }
      }
    },
    {
      "label": "WebAPI: Start (native)",
      "type": "shell",
      "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
      "args": ["-m", "uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8001", "--reload"],
      "options": {
        "cwd": "${workspaceFolder}/webapi",
        "env": {
          "PYTHONPATH": "${workspaceFolder}/webapi;${workspaceFolder}/database-service",
          "WEBAPI_PORT": "8001",
          "WORKER_URL": "http://localhost:8002"
        }
      },
      "isBackground": true,
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true },
      "problemMatcher": {
        "owner": "webapi",
        "pattern": { "regexp": "^ERROR" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Started server process",
          "endsPattern": "Application startup complete"
        }
      }
    },
    {
      "label": "All Services: Start (native)",
      "dependsOn": ["Worker: Start (native)", "WebAPI: Start (native)", "Frontend: ng serve (dev)"],
      "dependsOrder": "parallel",
      "presentation": { "reveal": "silent" },
      "problemMatcher": []
    },

    // ── Podman (webapi + frontend containers) ───────────────────────────
    {
      "label": "Podman: Build All Images",
      "type": "shell",
      "command": "powershell",
      "args": ["-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}\\podman-up.ps1", "-Build", "-NoStart"],
      "group": "build",
      "presentation": { "reveal": "always", "panel": "shared", "clear": true },
      "problemMatcher": []
    },
    {
      "label": "Podman: Build & Start",
      "type": "shell",
      "command": "powershell",
      "args": ["-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}\\podman-up.ps1", "-Build"],
      "group": "build",
      "presentation": { "reveal": "always", "panel": "shared", "clear": true },
      "problemMatcher": []
    },
    {
      "label": "Podman: Start",
      "type": "shell",
      "command": "powershell",
      "args": ["-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}\\podman-up.ps1"],
      "presentation": { "reveal": "always", "panel": "shared", "clear": true },
      "problemMatcher": []
    },
    {
      "label": "Podman: Stop",
      "type": "shell",
      "command": "powershell",
      "args": ["-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}\\podman-up.ps1", "-Down"],
      "presentation": { "reveal": "always", "panel": "shared", "clear": true },
      "problemMatcher": []
    },

    // ── Frontend ───────────────────────────────────────────────────────
    {
      "label": "Frontend: ng serve (dev)",
      "type": "shell",
      "command": "node",
      "args": [
        "./node_modules/@angular/cli/bin/ng",
        "serve",
        "--proxy-config", "proxy.conf.json"
      ],
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "isBackground": true,
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true },
      "problemMatcher": {
        "owner": "ng-serve",
        "pattern": { "regexp": "^ERROR in (.*)$", "file": 1, "message": 1 },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Building\\.",
          "endsPattern": "Application bundle generation complete"
        }
      }
    },
    {
      "label": "Frontend: npm install",
      "type": "shell",
      "command": "npm",
      "args": ["install"],
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "presentation": { "reveal": "always", "panel": "shared", "clear": true },
      "problemMatcher": []
    },
    {
      "label": "Frontend: ng build (production)",
      "type": "shell",
      "command": "npm",
      "args": ["run", "build", "--", "--configuration", "production"],
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "group": "build",
      "presentation": { "reveal": "always", "panel": "shared", "clear": true },
      "problemMatcher": ["$tsc"]
    }

  ]
}

    {
      "label": "Podman: Build & Start",
      "type": "shell",
      "command": "powershell",
      "args": ["-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}\\podman-up.ps1", "-Build"],
      "group": "build",
      "presentation": { "reveal": "always", "panel": "shared", "clear": true },
      "problemMatcher": []
    },
    {
      "label": "Podman: Start",
      "type": "shell",
      "command": "powershell",
      "args": ["-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}\\podman-up.ps1"],
      "presentation": { "reveal": "always", "panel": "shared", "clear": true },
      "problemMatcher": []
    },
    {
      "label": "Podman: Stop",
      "type": "shell",
      "command": "powershell",
      "args": ["-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}\\podman-up.ps1", "-Down"],
      "presentation": { "reveal": "always", "panel": "shared", "clear": true },
      "problemMatcher": []
    },

    // ── Frontend ────────────────────────────────────────────────────────────
    {
      "label": "Frontend: npm install",
      "type": "shell",
      "command": "npm",
      "args": ["install"],
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "presentation": { "reveal": "always", "panel": "shared", "clear": true },
      "problemMatcher": []
    },
    {
      "label": "Frontend: ng build (production)",
      "type": "shell",
      "command": "npm",
      "args": ["run", "build", "--", "--configuration", "production"],
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "group": "build",
      "presentation": { "reveal": "always", "panel": "shared", "clear": true },
      "problemMatcher": ["$tsc"]
    }

  ]
}
