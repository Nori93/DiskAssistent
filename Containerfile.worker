FROM python:3.12-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    && rm -rf /var/lib/apt/lists/*

# Copy shared packages first (better layer caching)
COPY database-service/ database-service/
COPY ai/ ai/

# Copy service
COPY worker-service/ worker-service/

# Install shared DB package first, then service dependencies
RUN pip install --no-cache-dir ./database-service
RUN pip install --no-cache-dir -r worker-service/requirements.txt

# Create required directories
RUN mkdir -p database logs frontend/static/img/thumbnails

EXPOSE 8002

WORKDIR /app/worker-service

CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8002"]
